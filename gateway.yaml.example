# Verkos inference gateway — example config.
# Copy to ./gateway.yaml (or /etc/verkos/gateway.yaml) and edit.
# See docs/INFERENCE_API_ARCHITECTURE.md §B.4.

auth:
  # Generated by scripts/generate_api_key.py. Must exist before the gateway boots.
  keys_file: "./keys.json"

# Catalog of bootable models. The gateway holds at most one sglang process
# at a time and spawns/swaps on demand (architecture doc §A.7, §B.5). An
# inference request for any catalog model triggers an implicit load (or swap,
# if a different model is loaded).
models:
  - id: "chat-vlm"
    # Path is resolved relative to this gateway.yaml file unless absolute.
    # The referenced YAML contains the sglang flags + loopback port for this model.
    config_ref: "workers/chat-vlm.yaml"
  - id: "bge-embed"
    config_ref: "workers/bge-embed.yaml"

server:
  host: "0.0.0.0"
  port: 8000
  log_level: "info"

gpu:
  poll_interval_s: 5.0

manager:
  # Max wait for sglang's /health to flip after spawn before the load is treated as failed.
  load_timeout_s: 120.0
  # How often the manager polls /health during a cold start.
  health_poll_interval_s: 0.5
  # Path to the Python interpreter that should host sglang. null → use the
  # interpreter the gateway is running under.
  spawn_python: null
